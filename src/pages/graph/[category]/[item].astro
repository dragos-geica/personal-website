---
import ItemPage from '../../../components/ItemPage.astro';
import { graphDestinations } from '../../../data/node-destinations';

export function getStaticPaths() {
  return graphDestinations.map((destination) => {
    const [, , category, slug] = destination.path.split('/');
    return { params: { category, item: slug }, props: { destination } };
  });
}

const { destination } = Astro.props;
---
<ItemPage item={destination.item} category={destination.parent} back={destination.back} />
