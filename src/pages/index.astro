---
import KnowledgeGraph from '../components/KnowledgeGraph';
import SiteLayout from '../layouts/SiteLayout.astro';
import { site } from '../content/site';

const egg = site.easterEgg;
// The address is put together in the browser, so simple bots reading the page do not see it.
const [emailUser, emailDomain] = egg.email.split('@');

const links = [
  { label: site.pages.about.title, href: '/about/' },
  { label: site.categories.projects.label, href: '/projects/' },
  { label: site.pages.research.title, href: '/research/' },
  { label: site.pages.cv.title, href: '/cv/' },
];
---
<SiteLayout title={`${site.name} — ${site.tagline}`}>
  <main id="main-content" class="home-scene" tabindex="-1" aria-labelledby="home-title">
    <header class="home-intro">
      <h1 id="home-title">
        <button type="button" class="name-toggle" aria-expanded="false" aria-controls="site-links">{site.name}</button>
      </h1>
      <nav id="site-links" class="site-links" aria-label="Pages" hidden>
        {links.map(({ label, href }) => <a href={href}>{label}</a>)}
      </nav>
      <p class="home-tagline">{site.tagline}</p>
      <p class="home-description">{site.intro}</p>
    </header>
    <section id="portrait-egg" class="portrait-egg" aria-labelledby="portrait-egg-title" hidden>
      <h2 id="portrait-egg-title">{egg.title}</h2>
      <p class="portrait-egg-text">{egg.text}</p>
      <p class="portrait-egg-invite">{egg.invite}</p>
      <p class="portrait-egg-contact">
        <a class="portrait-egg-email" data-user={emailUser} data-domain={emailDomain}></a>
        <button type="button" class="portrait-egg-copy">Copy</button>
      </p>
    </section>
    <div class="graph-stage">
      <KnowledgeGraph client:load transition:persist="knowledge-graph" />
    </div>
  </main>
</SiteLayout>

<script>
  // Clicking the name shows or hides the links to the other pages.
  document.addEventListener('astro:page-load', () => {
    const toggle = document.querySelector<HTMLButtonElement>('.name-toggle');
    const links = document.getElementById('site-links');
    if (!toggle || !links) return;
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      links.hidden = !open;
    };
    toggle.addEventListener('click', () => set(links.hidden));
    links.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') { set(false); toggle.focus(); }
    });
    toggle.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') set(false);
    });
  });
</script>
