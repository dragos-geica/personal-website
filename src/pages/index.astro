---
import KnowledgeGraph from '../components/KnowledgeGraph';
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="DG — Personal Knowledge Graph">
  <main id="main-content" class="home-scene" tabindex="-1" aria-labelledby="home-title">
    <section class="home-intro" aria-labelledby="home-title">
      <p class="home-eyebrow">A PERSONAL KNOWLEDGE GRAPH</p>
      <h1 id="home-title">My world, connected.</h1>
      <p class="home-description">A living map of what I study, build, research, and enjoy.</p>
      <div class="intro-action">
        <a href="#knowledge-graph" class="explore-link">Explore the graph <span aria-hidden="true">→</span></a>
      </div>
    </section>
    <KnowledgeGraph client:idle />
  </main>
</SiteLayout>
