---
import KnowledgeGraph from '../components/KnowledgeGraph';
import SiteLayout from '../layouts/SiteLayout.astro';
import { site } from '../content/site';
---
<SiteLayout title={`${site.name} — ${site.tagline}`}>
  <main id="main-content" class="home-scene" tabindex="-1" aria-labelledby="home-title">
    <header class="home-intro">
      <h1 id="home-title">{site.name}</h1>
      <p class="home-tagline">{site.tagline}</p>
      <p class="home-description">{site.intro}</p>
    </header>
    <KnowledgeGraph client:load transition:persist="knowledge-graph" />
  </main>
</SiteLayout>
