---
import ItemPage from '../../components/ItemPage.astro';
import { projects } from '../../data/projects';
import { branchPath } from '../../data/branch-location';
import { site } from '../../content/site';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { project: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---
<ItemPage item={project} category={site.categories.projects.label} back={branchPath({ parent: 'projects' })} />
