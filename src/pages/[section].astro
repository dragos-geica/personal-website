---
import SiteLayout from '../layouts/SiteLayout.astro';
import { projects, projectPath } from '../data/projects';
import { site } from '../content/site';

export function getStaticPaths() {
  return (['projects', 'research', 'about', 'cv'] as const).map((section) => ({ params: { section } }));
}

const { section } = Astro.params;
const isProjects = section === 'projects';
const page = isProjects
  ? { title: site.categories.projects.label, paragraphs: ['Explore the projects featured in the knowledge graph.'] }
  : site.pages[section as 'about' | 'research' | 'cv'];
---
<SiteLayout title={`${page.title} — ${site.name}`} description={page.paragraphs[0]} noindex={!isProjects}>
  <main id="main-content" class="section-page mx-auto" tabindex="-1">
    <p class="section-eyebrow">{site.name}</p>
    <h1>{page.title}</h1>
    {page.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    {isProjects && (
      <ul class="project-directory" aria-label="Projects">
        {projects.map((project) => (
          <li>
            <a href={projectPath(project.slug)}>{project.title}</a>
            <p>{project.draft ? 'Project placeholder' : 'Case study'}</p>
          </li>
        ))}
      </ul>
    )}
    <a class="back-link" href="/">← Back to the knowledge graph</a>
  </main>
</SiteLayout>
