---
import SiteLayout from '../layouts/SiteLayout.astro';
import { projects, projectPath } from '../data/projects';

export function getStaticPaths() {
  return [
    { params: { section: 'projects' }, props: { title: 'Projects', description: 'Explore the projects featured in the knowledge graph.' } },
    { params: { section: 'research' }, props: { title: 'Research', description: 'Research interests, notes, and publications will go here.' } },
    { params: { section: 'about' }, props: { title: 'About', description: 'A short biography and portrait will go here.' } },
    { params: { section: 'cv' }, props: { title: 'CV', description: 'Education, experience, and a downloadable CV will go here.' } },
  ];
}

const { title, description } = Astro.props;
const isProjects = Astro.params.section === 'projects';
---
<SiteLayout title={`DG — ${title}`} description={description} noindex={!isProjects}>
  <main id="main-content" class="section-page mx-auto" tabindex="-1">
    <p class="section-eyebrow">{isProjects ? 'Knowledge graph' : 'Content placeholder'}</p>
    <h1>{title}</h1>
    <p>{description}</p>
    {isProjects && (
      <ul class="project-directory" aria-label="Projects">
        {projects.map((project) => (
          <li>
            <a href={projectPath(project.slug)}>{project.title}</a>
            <p>{project.placeholder ? 'Project placeholder' : 'Case study'}</p>
          </li>
        ))}
      </ul>
    )}
    <a class="back-link" href="/">← Back to the knowledge graph</a>
  </main>
</SiteLayout>
