---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { site } from '../content/site';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = site.intro, noindex } = Astro.props;
const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <ClientRouter fallback="swap" />
    <script is:inline>
      if (location.pathname === '/' && new URLSearchParams(location.search).has('branch')) {
        document.documentElement.dataset.graphPending = '';
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <div id="node-morph" transition:persist="node-morph" aria-hidden="true" hidden></div>
    <div id="branch-return" transition:persist="branch-return" aria-hidden="true" hidden></div>
  </body>
</html>

<script>
  import { applyMotionProperties } from '../scripts/motion';
  import '../scripts/node-navigation';
  import '../scripts/branch-return-motion';
  import '../scripts/branch-sound';
  import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';

  // Durations and easings come from one module and are mirrored as CSS custom properties.
  applyMotionProperties(document.documentElement);

  document.addEventListener('astro:before-swap', (event) => {
    const next = (event as TransitionBeforeSwapEvent).newDocument.documentElement;
    // Astro swaps the root element's attributes, including the motion properties.
    applyMotionProperties(next);
  });
</script>
