---
// One page per graph item. Everything shown here comes from src/content/site.ts.
import SiteLayout from '../layouts/SiteLayout.astro';
import type { ContentItem } from '../content/types';
import { tagHref } from '../data/tags';

interface Props {
  item: ContentItem;
  category: string;
  back: string;
}

const { item, category, back } = Astro.props;
---
<SiteLayout title={`${item.title} — ${category}`} description={item.summary} noindex={item.draft}>
  <main id="main-content" class="section-page project-detail mx-auto" tabindex="-1">
    <a class="explore-link leaf-back" href={back} data-morph-back><span aria-hidden="true">←</span> Back</a>
    <p class="section-eyebrow">{item.draft ? `${category} · in progress` : category}</p>
    <h1 data-morph-heading tabindex="-1">{item.title}</h1>
    {item.subtitle && <p class="detail-subtitle">{item.subtitle}</p>}
    {!!item.tags?.length && (
      <ul class="tag-list" aria-label="Data, tools and methods">
        {item.tags.map((tag) => {
          const href = tagHref(tag);
          return <li>{href ? <a class="tag" href={href}>{tag}</a> : <span class="tag">{tag}</span>}</li>;
        })}
      </ul>
    )}
    <p class="detail-summary">{item.summary}</p>
    {item.image && <img class="project-image detail-image" src={item.image.src} alt={item.image.alt || `Photo from ${item.title}`} decoding="async" />}
    {!!item.facts?.length && (
      <dl class="project-metrics">
        {item.facts.map(({ label, value }) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
      </dl>
    )}
    {item.sections?.map(({ title, text }) => (
      <section class="detail-section">
        <h2>{title}</h2>
        <p>{text}</p>
      </section>
    ))}
    {!!item.links?.length && (
      <section class="detail-section">
        <h2>Links</h2>
        <ul>{item.links.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}</ul>
      </section>
    )}
  </main>
</SiteLayout>
